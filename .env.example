FLASK_ENV=development
SECRET_KEY=replace-with-secure-random-string
# DATABASE_URL=sqlite:///skill_orbit_india.db  # Local SQLite fallback
DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<database_name>?sslmode=require
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-dedicated-webhook-secret
ADMIN_EMAIL=admin@skillorbit.in
ADMIN_PASSWORD=replace-with-strong-admin-password

# One-time setup only: set true to create the first admin, then set false.
ADMIN_BOOTSTRAP_ENABLED=false
# Optional explicit super-admin identity; keep this mailbox under strict control.
SUPER_ADMIN_EMAIL=admin@example.com
